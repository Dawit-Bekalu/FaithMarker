    private fun languageDialog() {

        val values =
            arrayOf(
                "English",
                "Amharic"
            )

        val checked =
            if (
                language == "Amharic"
            )
                1
            else
                0

        modernDialog()
            .setTitle(
                "Language"
            )
            .setSingleChoiceItems(
                values,
                checked
            ) { dialog, which ->

                language =
                    values[which]

                prefs.edit()
                    .putString(
                        "language",
                        language
                    )
                    .apply()

                dialog.dismiss()

                showSettings()
            }
            .show()
    }

