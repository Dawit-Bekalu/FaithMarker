    private fun addBooks(
        testament: String,
        group: String,
        list: List<Pair<String, Int>>
    ) {

        list.forEach {

            books.add(
                BibleBook(
                    name = it.first,
                    chapters = it.second,
                    testament = testament,
                    group = group
                )
            )
        }
    }

    // ========================================================
    // CUSTOM BOOK STORAGE
    // ========================================================

    private fun loadCustomBooks() {

        val json =
            prefs.getString(
                "custom_books",
                null
            ) ?: return

        try {

            val array =
                JSONArray(json)

            for (i in 0 until array.length()) {

                val o =
                    array.getJSONObject(i)

                val name =
                    o.optString("name")

                if (
                    name.isNotEmpty() &&
                    books.none {
                        it.name == name
                    }
                ) {

                    books.add(
                        BibleBook(
                            name,
                            o.optInt("chapters", 1),
                            o.optString(
                                "testament",
                                "Old Testament"
                            ),
                            o.optString(
                                "group",
                                "Custom"
                            )
                        )
                    )
                }
            }

        } catch (_: Exception) {
        }
    }

    private fun saveCustomBooks() {

        val array =
            JSONArray()

        /*
           Only custom books are saved.
           Default 66 books are recreated on every launch.
        */

        val defaultNames =
            defaultBookNames()

        books
            .filter {
                !defaultNames.contains(it.name)
            }
            .forEach {

                val o =
                    JSONObject()

                o.put(
                    "name",
                    it.name
                )

                o.put(
                    "chapters",
                    it.chapters
                )

                o.put(
                    "testament",
                    it.testament
                )

                o.put(
                    "group",
                    it.group
                )

                array.put(o)
            }

        prefs.edit()
            .putString(
                "custom_books",
                array.toString()
            )
            .apply()
    }

